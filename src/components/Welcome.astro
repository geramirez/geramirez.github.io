---
import Pottery from "../assets/pottery-art.jpg"
import { Image } from 'astro:assets';
---

<main>

  <section class="hero">
    <h1>Hi, I’m Gabriel.</h1>
    <p class="subtitle">
      Software engineer and engineering leader.
    </p>
    <p>
      I build reliable backend systems, lead technical initiatives,
      and help teams ship products from early ideas to production scale.
    </p>

    <Image class="home-image" src={Pottery} alt="my pottery"/>


  </section>

</main>

<style>

    .hero {
        text-align: center;
    }

  .subtitle {
    font-size: var(--font-size-2);
  }

    .home-image {
        width: 20em;
        height: 10em;
        border-radius: 10%;
        margin: .1em;
        object-fit: cover;
    }

</style>