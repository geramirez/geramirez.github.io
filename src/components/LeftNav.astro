---
const normalize = ( path: string ) => (path === "/" ? "/" : path.replace(/\/$/, ""));
const currentPath = normalize(Astro.url.pathname);
const isActive = ( href: string ) => normalize(href) === currentPath;
---

<div class="nav-container">
  <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Toggle navigation" />

  <label class="mobile-toggle" for="nav-toggle">
    <span class="brand">Gabriel Ramírez</span>
    <span class="burger" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </span>
  </label>

  <label class="backdrop" for="nav-toggle" aria-hidden="true"></label>

  <aside class="sidebar" id="sidebar-nav">
    <section class="sidebar-section">
      <h1 class="brand"><a href="/">Gabriel Ramírez</a></h1>
    </section>
    <section class="sidebar-section">
      <a href="/work-experience" class:list={{ active: isActive('/work-experience') }}>Work Experience</a>
      <a href="/projects" class:list={{ active: isActive('/projects') }}>Projects</a>
      <a href="/about" class:list={{ active: isActive('/about') }}>About Me</a>
    </section>
    <hr>
    <section class="sidebar-section">
      <h2 class="section-title">Connect</h2>
      <a href="https://github.com/geramirez">GitHub</a>
      <a href="https://www.linkedin.com/in/gramire1/">LinkedIn</a>
    </section>
  </aside>
</div>

<script>
  // Keep the mobile sidebar aligned below the header across devices
  const setMobileHeaderHeight = () => {
    const container = document.querySelector('.nav-container');
    const header = document.querySelector('.mobile-toggle');
    if (container && header) {
      const h = (header as HTMLElement).offsetHeight || 58;
      (container as HTMLElement).style.setProperty('--mobile-header-h', `${h}px`);
    }
  };

  // Initialize and keep in sync with viewport / font changes
  if (typeof window !== 'undefined') {
    // Run asap after layout
    setMobileHeaderHeight();
    // Recompute on resize and orientation changes
    window.addEventListener('resize', setMobileHeaderHeight, { passive: true });
    window.addEventListener('orientationchange', setMobileHeaderHeight, { passive: true });
    // Recompute after fonts load (sizes can change)
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(setMobileHeaderHeight).catch(() => {});
    }
  }
</script>

<style>
  .nav-container {
    position: relative;
    width: 240px;
    margin: 0;
  }

  .nav-toggle {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .mobile-toggle {
    display: none;
  }

  .burger {
    display: inline-flex;
    flex-direction: column;
    gap: 5px;
  }

  .burger span {
    display: block;
    width: 22px;
    height: 2px;
    background: #111827;
    transition: transform 150ms ease, opacity 150ms ease;
  }

  .sidebar {
    position: sticky;
    top: 0;
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px 20px;
    width: 240px;
    min-height: 100vh;
    box-sizing: border-box;
    border-right: 1px solid #e5e7eb;
    background: #fafafa;
    z-index: 2;
  }

  .brand {
    font-weight: 700;
    margin: 0;
    font-size: var(--font-size-4);
    color: #111827;
    text-decoration: none;
  }

  .sidebar-section {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .section-title {
    padding: 8px 6px;
    margin: 0;
    font-size: var(--font-size-2);
  }

  .menu {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .sidebar a {
    color: #374151;
    text-decoration: none;
    padding: 8px 6px;
    border-radius: 6px;
    transition: background 120ms ease, color 120ms ease;
  }

  .sidebar a:hover {
    background: #f3f4f6;
  }

  .sidebar a.active {
    background: #e5e7eb;
    color: #111827;
    font-weight: 600;
  }

  .sidebar hr {
    border: none;
    border-top: 1px solid #e5e7eb;
    margin: 0;
  }

  .backdrop {
    display: none;
  }

  @media (max-width: 900px) {
    /* Show brand inside the slide-out on mobile as well */

    .nav-container {
      position: relative;
      width: auto;
      max-width: 100%;
      z-index: 10;
      /* Default; updated dynamically via script for accuracy */
      --mobile-header-h: 58px;
    }

    .mobile-toggle {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 14px 16px;
      /* Safe-area support (iOS notch, cutouts). Provide base first, override where supported. */
      padding-top: 14px;
      padding-left: 16px;
      padding-right: 16px;
      padding-top: calc(14px + env(safe-area-inset-top));
      padding-left: calc(16px + env(safe-area-inset-left));
      padding-right: calc(16px + env(safe-area-inset-right));
      background: #fafafa;
      border-bottom: 1px solid #e5e7eb;
      font-weight: 700;
      font-size: var(--font-size-1);
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 13;
      pointer-events: auto;
      cursor: pointer;
    }

    .sidebar {
      position: fixed;
      top: var(--mobile-header-h, 58px);
      left: 0;
      width: min(280px, 85vw);
      height: calc(100dvh - var(--mobile-header-h, 58px));
      /* Scroll content if taller than viewport */
      overflow: auto;
      -webkit-overflow-scrolling: touch;
      border-right: 1px solid #e5e7eb;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.14);
      transform: translateX(-100%);
      transition: transform 180ms ease-out;
      background: #fafafa;
      pointer-events: auto;
      z-index: 12;
      will-change: transform;
      /* Safe-area left padding for landscape notch devices. Base first, then override. */
      padding-left: 20px;
      padding-left: calc(20px + env(safe-area-inset-left));
    }

    .nav-toggle:checked ~ .sidebar {
      transform: translateX(0);
    }

    .nav-toggle:checked ~ .mobile-toggle .burger span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }

    .nav-toggle:checked ~ .mobile-toggle .burger span:nth-child(2) {
      opacity: 0;
    }

    .nav-toggle:checked ~ .mobile-toggle .burger span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }

    .backdrop {
      display: block;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.28);
      opacity: 0;
      transition: opacity 150ms ease;
      pointer-events: none;
      z-index: 11;
      cursor: pointer;
    }

    .nav-toggle:checked ~ .backdrop {
      opacity: 1;
      pointer-events: auto;
    }

    /* Keep nav content from pushing layout on mobile */
    .nav-toggle:not(:checked) ~ .sidebar {
      transform: translateX(-100%);
    }

    .nav-toggle:checked ~ .sidebar,
    .nav-toggle:checked ~ .backdrop {
      pointer-events: auto;
    }
  }

  /* Respect user preference to reduce motion */
  @media (prefers-reduced-motion: reduce) {
    .sidebar {
      transition: none !important;
    }
    .burger span {
      transition: none !important;
    }
  }
</style>
