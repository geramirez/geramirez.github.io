---
import LeftNav from "../components/LeftNav.astro";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Gabriel Ramírez</title>
	</head>
	<body>
		<div class="app">
			<LeftNav />
			<main class="content">
				<slot />
			</main>
		</div>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	.app {
		display: flex;
		min-height: 100vh;
	}

	.content {
		flex: 1;
		padding: 32px;
		box-sizing: border-box;
	}

	@media (max-width: 900px) {
		.content {
			flex: 1;
			padding: 2.5rem;
			box-sizing: border-box;
		}
	}
	
</style>
