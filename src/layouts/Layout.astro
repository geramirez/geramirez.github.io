---
import LeftNav from "../components/LeftNav.astro";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Gabriel Ramírez</title>
	</head>
	<body>
		<div class="app">
			<LeftNav />
			<main class="content">
				<slot />
			</main>
		</div>
	</body>
</html>

<style is:global>
	:root {
		--font-size-0: 0.875rem; /* 14px */
		--font-size-1: 1rem;     /* 16px */
		--font-size-2: 1.125rem; /* 18px */
		--font-size-3: 1.25rem;  /* 20px */
		--font-size-4: 1.5rem;   /* 24px */
		--font-size-5: 1.875rem; /* 30px */
		--font-size-6: 2.25rem;  /* 36px */
		--line-height: 1.6;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	body {
		font-size: var(--font-size-2);
		line-height: var(--line-height);
		color: #111827;
	}

	h1, h2, h3, h4, h5, h6 {
		margin: 0.67em 0 0.4em;
		line-height: 1.2;
	}

	h1 { font-size: var(--font-size-5); }
	h2 { font-size: var(--font-size-4); }
	h3 { font-size: var(--font-size-3); }

	p, li { font-size: inherit; }

	/* Typography utilities */
	.-small { font-size: var(--font-size-0); }
	.-lead  { font-size: var(--font-size-3); }
	.-muted { color: #6b7280; }

	.app {
		display: flex;
		min-height: 100vh;
	}

	.content {
		flex: 1;
		padding: 32px;
		margin-top: 1.2rem;
		box-sizing: border-box;
	}

	@media (max-width: 900px) {
		.content {
			flex: 1;
			padding: 2.5rem;
			box-sizing: border-box;
		}
	}
</style>
